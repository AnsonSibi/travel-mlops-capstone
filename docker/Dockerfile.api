# Flask REST API for flight price prediction (+ gender and hotel endpoints)
# Build from the repo root:  docker build -f docker/Dockerfile.api -t travel-ml-api:latest .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PROJECT_ROOT=/app \
    PORT=5000

WORKDIR /app

# install dependencies first so this layer is cached between code changes
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# shared package (feature engineering, monitoring, gender helpers)
COPY pyproject.toml .
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

COPY api ./api
COPY models ./models

# run as a non-root user; logs/ and reports/ must be writable for prediction logging
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p logs reports data/processed \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" || exit 1

CMD ["gunicorn", "--workers", "2", "--threads", "4", "--bind", "0.0.0.0:5000", \
     "--access-logfile", "-", "--timeout", "60", "api.app:app"]
